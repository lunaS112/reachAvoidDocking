{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Docking6D (no wandb)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/deepReachMPCReachAvoid/run_experiment.py",
            "args": [
                "--mode", "train",
                "--experiment_name", "Docking6D_RA_debug", 
                "--dynamics_class", "Docking6D",
                "--tMax", "10",
                "--pretrain",
                "--pretrain_iters", "1000",
                "--num_epochs", "110000",
                "--counter_end", "100000",
                "--num_nl", "512",
                "--set_mode", "reach_avoid",
                "--lr", "2e-5",
                "--num_iterative_refinement", "10",
                "--MPC_batch_size", "5000",
                "--num_MPC_batches", "20",
                "--num_MPC_data_samples", "5000",
                "--numpoints", "50000",
                "--MPC_style", "receding",
                "--MPC_receding_horizon", "1",
                "--MPC_dt", "0.2",
                "--deepReach_model", "exact",
                "--pause_epochs", "100",
                "--val_z_resolution", "5",
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/deepReachMPCReachAvoid"
        }
    ]
}
